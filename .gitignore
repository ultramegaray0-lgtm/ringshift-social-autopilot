.venv/
__pycache__/
*.pyc
.env
.env.*
# Local copy of the game used for capture; never commit it here.
game/
# Scratch output of capture runs; finished clips are copied into media/ deliberately.
media/captured-tmp/
# Unattended runs: the game checkout, lab outputs and per-run files (never committed)
game-src/
lab-levels/
lab-theme/
theme-out/
lab-out/
preview_draft.json
auto_result.json
approved/
# Local (non-Actions) claims; in Actions claims are git tags
data/used_approvals/
data/used_days/
# TikTok videos: finished videos are GitHub Actions artifacts, never committed (only the folder's README is).
media/tiktok-output/*
!media/tiktok-output/README.md
# TikTok state lives on the tiktok-state branch; the local copy is scratch.
data/tiktok_state.json
data/tiktok_state.json.tmp
